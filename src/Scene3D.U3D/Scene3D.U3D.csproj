    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scene3D\Scene3D.csproj" />
    <InternalsVisibleTo Include="Scene3D.Tests" Key="$(Scene3DPublicKey)" />
