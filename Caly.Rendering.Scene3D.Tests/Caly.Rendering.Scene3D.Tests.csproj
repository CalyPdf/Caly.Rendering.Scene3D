<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 test projects are executables. They stay on VSTest (`dotnet test` as before). -->
    <OutputType>Exe</OutputType>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Caly.Rendering.Scene3D\Caly.Rendering.Scene3D.csproj" />
    <ProjectReference Include="..\Caly.Rendering.Scene3D.U3D\Caly.Rendering.Scene3D.U3D.csproj" />
    <ProjectReference Include="..\Caly.Rendering.Scene3D.Prc\Caly.Rendering.Scene3D.Prc.csproj" />
    <ProjectReference Include="..\tools\Caly.Rendering.Scene3D.Prc.Generator\Caly.Rendering.Scene3D.Prc.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Update="TestData\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>